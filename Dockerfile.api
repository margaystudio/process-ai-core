# Multi-stage: build deps en builder, solo runtime en la imagen final.
FROM python:3.12-slim AS builder

WORKDIR /app

# Las dependencias se instalan desde requirements.lock y NO resolviendo los
# rangos de pyproject.toml. La diferencia no es de estilo:
#
#   `fastapi>=0.104.0` es lo que el proyecto ACEPTA; el lock es lo que
#   efectivamente VA. Resolviendo en cada build, el mismo commit produce
#   imágenes distintas según el día — pip elige lo más nuevo publicado en ese
#   momento, incluidas las transitivas que nadie declaró. Pasó: CI saltó solo a
#   Starlette 1.x (un major) y rompió un test que en local pasaba.
#
# Para un módulo cuyo argumento es la gobernanza documental, que el artefacto
# que produce sea reproducible y el binario que lo produce no, es una asimetría
# difícil de defender.
#
# Regenerar el lock (ver también requirements.lock):
#   uv pip compile pyproject.toml --universal --python-version 3.12 --generate-hashes -o requirements.lock
#   uv pip compile pyproject.toml --extra dev --universal --python-version 3.12 --generate-hashes -o requirements-dev.lock
#
# `--generate-hashes` no es cosmético: sin hashes, `pip install -r` acepta
# cualquier artefacto que el índice devuelva para esa versión. Con hashes, un
# paquete alterado en el registro o en un mirror falla la instalación en vez
# de entrar a la imagen. Versión fija ≠ integridad.
#
# El orden de las capas importa: las dependencias van ANTES que el código, así
# un cambio en process_ai_core/ no invalida la capa de deps (que es la cara).
COPY requirements.lock ./
RUN pip install --no-cache-dir --target /app/deps -r requirements.lock

# El proyecto, sin resolver dependencias: ya están todas arriba, ancladas.
# `psycopg[binary]` salió de acá: estaba suelto en la línea de pip y ya está
# declarado en pyproject.toml, así que ahora entra por el lock como el resto.
COPY pyproject.toml ./
COPY process_ai_core/ process_ai_core/
COPY api/ api/

RUN pip install --no-cache-dir --target /app/deps --no-deps .

RUN find /app/deps -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true \
 && find /app/deps -name "*.pyc" -delete \
 && find /app/deps -type d -name "tests" -exec rm -rf {} + 2>/dev/null || true \
 && find /app/deps -type d -name "test" -exec rm -rf {} + 2>/dev/null || true

FROM python:3.12-slim

WORKDIR /app

# fonts-liberation: sin esto WeasyPrint no encontraba NINGUNA de las familias
# pedidas por el CSS ('Helvetica Neue', Arial) y caía a DejaVu Sans, así que el
# PDF de producción no coincidía con el de desarrollo. Liberation Sans es
# métricamente compatible con Arial/Helvetica: misma paginación en los dos lados.
# Si cambia la familia en process_ai_core/export/pdf_weasyprint.py, hay que
# cambiar el paquete acá también.
# Sin pandoc: quedó sin uso al pasar a WeasyPrint como único motor de salida.
# La importación de documentos NO lo usa — extrae texto con PyMuPDF (.pdf) y
# python-docx (.docx). Son ~150 MB menos de imagen y menos cold start.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    fonts-liberation \
    fontconfig \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/deps /app/deps
COPY process_ai_core/ process_ai_core/
COPY api/ api/

RUN mkdir -p /app/data /app/output

ENV PYTHONUNBUFFERED=1 \
    ENVIRONMENT=prod \
    PYTHONPATH=/app/deps \
    PORT=8080

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080"]
